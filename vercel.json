{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "vercel-server.mjs",
      "buildCommand": "npm run build:vercel"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "ALTASGOODS_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/v1/cron/tick",
      "schedule": "0 3 * * *"
    }
  ]
}
