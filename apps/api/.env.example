# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://localhost:5432/altasgoods_dev
TEST_DATABASE_URL=postgres://localhost:5432/altasgoods_test
REDIS_URL=redis://localhost:6379/5
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# HMAC secret for the sandbox payment provider webhooks
PAYMENTS_WEBHOOK_SECRET=change-me-sandbox-webhook-secret
# Origin of the web app, for CORS and payment return URLs
WEB_ORIGIN=http://localhost:3000
# Payment gateway: "sandbox" (local, no real money) or "razorpay"
PAYMENTS_PROVIDER=sandbox
# Razorpay Dashboard > Account & Settings > API Keys (rzp_test_... in test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set on the webhook in Razorpay Dashboard > Account & Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Courier: "simulated" (scans driven by hand in the admin panel) or "shiprocket"
LOGISTICS_PROVIDER=simulated
# A Shiprocket API user (Settings > API > Configure > Create an API User), not your login
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Nickname of the pickup address in Shiprocket (Settings > Pickup Addresses), for example Primary
SHIPROCKET_PICKUP_LOCATION=
# Optional: the token you set on the Shiprocket tracking webhook. Tracking is polled every 10 minutes either way
SHIPROCKET_WEBHOOK_TOKEN=
# Parcel size in cm (LxBxH) sent with every shipment; weight comes from each product
SHIPPING_BOX_CM=20x15x10
# Email (password reset codes, email verification): "console" writes to the log (development only), "smtp" sends.
# Production refuses to start with "console". Works with any SMTP service: Zoho Mail, Brevo, Google Workspace, Amazon SES (SMTP), Hostinger...
EMAIL_PROVIDER=console
SMTP_HOST=
# 587 with STARTTLS (usual), or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# The sender people see. Its domain needs SPF and DKIM records from your SMTP service, or mail lands in spam
EMAIL_FROM="AltasGoods <no-reply@altasgoods.in>"
