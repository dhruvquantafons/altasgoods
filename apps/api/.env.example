# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://localhost:5432/altasgoods_dev
TEST_DATABASE_URL=postgres://localhost:5432/altasgoods_test
REDIS_URL=redis://localhost:6379/5
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# HMAC secret for the sandbox payment provider webhooks
PAYMENTS_WEBHOOK_SECRET=change-me-sandbox-webhook-secret
# Origin of the web app, for CORS and payment return URLs
WEB_ORIGIN=http://localhost:3000
# Who may name the client in X-Forwarded-For (Express "trust proxy"). Sign in, sign up and
# reset code limits count per client address, so this decides whose address they see.
# Shoppers never call the API directly: the web server does, and forwards the shopper's
# address in X-Forwarded-For. So the web server must reach the API from an address listed
# here, and nothing a shopper can reach directly may be listed.
#   loopback (default): web and API on the same machine
#   a comma list of addresses or CIDR ranges, for example 10.0.0.0/8 or loopback,172.18.0.5
#   a number: trust that many hops in front of the API
#   false: ignore the header (every request then counts as the web server's address)
#   true: trust any sender. Never in production: anyone could pick their own address
# If a reverse proxy (nginx, a load balancer) sits in front of the web server, have it set
# X-Forwarded-For (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
TRUST_PROXY=loopback
# Payment gateway: "sandbox" (local, no real money) or "razorpay"
PAYMENTS_PROVIDER=sandbox
# Razorpay Dashboard > Account & Settings > API Keys (rzp_test_... in test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set on the webhook in Razorpay Dashboard > Account & Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Courier: "simulated" (scans driven by hand in the admin panel) or "shiprocket"
LOGISTICS_PROVIDER=simulated
# A Shiprocket API user (Settings > API > Configure > Create an API User), not your login
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Nickname of the pickup address in Shiprocket (Settings > Pickup Addresses), for example Primary
SHIPROCKET_PICKUP_LOCATION=
# Optional: the 6 digit pincode parcels are picked up from. With it, Shiprocket also checks each delivery pincode (cached 12 hours); without it only the admin Delivery areas rules apply
# SHIPROCKET_PICKUP_PINCODE=560001
# Optional: the token you set on the Shiprocket tracking webhook. Tracking is polled every 10 minutes either way
SHIPROCKET_WEBHOOK_TOKEN=
# Parcel size in cm (LxBxH) sent with every shipment; weight comes from each product
SHIPPING_BOX_CM=20x15x10
# Email (password reset codes, email verification): "console" writes to the log (development only), "smtp" sends.
# Production refuses to start with "console". Sends through a Titan Mail mailbox (smtp.titan.email).
EMAIL_PROVIDER=console
SMTP_HOST=smtp.titan.email
# 465 with SMTP_SECURE=true, or 587 with STARTTLS
SMTP_PORT=465
SMTP_SECURE=true
# The full mailbox address and its password
SMTP_USER=
SMTP_PASSWORD=
# The sender people see. Titan rejects a From that is not SMTP_USER (or an alias of it).
# The domain needs Titan's SPF and DKIM records, or mail lands in spam
EMAIL_FROM="AltasGoods <no-reply@altasgoods.in>"
